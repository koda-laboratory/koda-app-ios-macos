# Copy to fastlane/.env (ignored by Git) and fill in the values. Never commit real values.

# App Store Connect API key (App Manager role).
APP_STORE_CONNECT_API_KEY_ID=
APP_STORE_CONNECT_API_KEY_ISSUER_ID=
# Base64 of the .p8 file contents (base64 -i AuthKey_XXXX.p8 | tr -d '\n').
APP_STORE_CONNECT_API_KEY_CONTENT=

# match: passphrase of koda-laboratory/mobile-macos-ios-certs.
MATCH_PASSWORD=
# Base64 of "githubuser:token" with read access to the certificates repository (CI; optional locally).
MATCH_GIT_BASIC_AUTHORIZATION=
# Password of the temporary CI keychain (CI only).
MATCH_KEYCHAIN_PASSWORD=
