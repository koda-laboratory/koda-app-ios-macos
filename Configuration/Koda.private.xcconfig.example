// Copy to Configuration/Koda.private.xcconfig (ignored by Git) and fill in the values.
// Only the publishable key (sb_publishable_…) belongs in the app. Never put sb_secret_… keys here.
SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
// Optional: override the project URL locally ($() keeps // from being parsed as a comment).
// SUPABASE_URL = https:/$()/<project-ref>.supabase.co
