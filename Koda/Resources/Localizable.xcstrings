{
  "sourceLanguage": "en",
  "strings": {
    "common.coming-soon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Coming soon"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Próximamente"
          }
        }
      }
    },
    "error.code.email-not-confirmed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your email has not been confirmed yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu email aún no está confirmado."
          }
        }
      }
    },
    "error.code.expired-session": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. Vuelve a iniciar sesión."
          }
        }
      }
    },
    "error.code.invalid-credentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect email or password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Email o contraseña incorrectos."
          }
        }
      }
    },
    "error.code.user-unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account is not available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta no está disponible."
          }
        }
      }
    },
    "error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado"
          }
        }
      }
    },
    "error.type.authentication": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not verify your session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido verificar tu sesión."
          }
        }
      }
    },
    "error.type.bad-request": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request is not valid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La petición no es válida."
          }
        }
      }
    },
    "error.type.bad-response": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server response could not be read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la respuesta del servidor."
          }
        }
      }
    },
    "error.type.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La petición se ha cancelado."
          }
        }
      }
    },
    "error.type.conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This data changed on another device. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos datos han cambiado en otro dispositivo. Vuelve a intentarlo."
          }
        }
      }
    },
    "error.type.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You do not have access to this content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes acceso a este contenido."
          }
        }
      }
    },
    "error.type.internal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unexpected error occurred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha ocurrido un error inesperado."
          }
        }
      }
    },
    "error.type.no-internet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Your changes will sync when you are back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión. Tus cambios se sincronizarán cuando vuelvas a tener red."
          }
        }
      }
    },
    "error.type.not-found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not find what you are looking for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos encontrado lo que buscas."
          }
        }
      }
    },
    "error.type.rate-limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera un momento y vuelve a intentarlo."
          }
        }
      }
    },
    "error.type.server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is not responding. Your changes are kept on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no responde. Tus cambios se guardan en este dispositivo."
          }
        }
      }
    },
    "error.type.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not access the data stored on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido acceder a los datos guardados en este dispositivo."
          }
        }
      }
    },
    "error.type.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request took too long."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La petición ha tardado demasiado."
          }
        }
      }
    },
    "error.type.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown error."
          }
        },
